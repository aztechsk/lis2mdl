#!/bin/sh
set -eu

cd "$(dirname "$0")"

if command -v shasum >/dev/null 2>&1; then
	sha256_file() { shasum -a 256 "$1"; }
elif command -v sha256sum >/dev/null 2>&1; then
	sha256_file() { sha256sum "$1"; }
else
	printf '%s\n' 'shasrcs: neither shasum nor sha256sum is available' >&2
	exit 1
fi

for file in lis2mdl.hzp Makefile README.md; do
	if [ ! -f "$file" ]; then
		printf 'shasrcs: missing file: %s\n' "$file" >&2
		exit 1
	fi
done
if [ ! -d src ]; then
	printf '%s\n' 'shasrcs: missing directory: src' >&2
	exit 1
fi

tmp=$(mktemp "${TMPDIR:-/tmp}/shasrcs.XXXXXXXX")
trap 'rm -f "$tmp"' 0
trap 'exit 1' 1 2 3 15

{
	printf '%s\n' lis2mdl.hzp Makefile README.md
	find src -type f ! -name '._*' ! -name '.DS_Store' \
		! -path '*/.svn/*' ! -path '*/.git/*' -print
} | LC_ALL=C sort | while IFS= read -r file; do
	sha256_file "$file"
done > "$tmp"
sha256_file "$tmp" | awk '{print $1}'
